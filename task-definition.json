{
  "family": "tybee-backend-task",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "tybee-backend",
      "image": "168379940497.dkr.ecr.us-east-2.amazonaws.com/tybee-backend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/tybee-backend",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "environment": [
        {
          "name": "DEBUG",
          "value": "True"
        },
        {
          "name": "DB_ENGINE",
          "value": "django.db.backends.postgresql"
        },
        {
          "name": "DB_NAME",
          "value": "postgres"
        },
        {
          "name": "EMAIL_HOST",
          "value": "smtp.example.com"
        },
        {
          "name": "EMAIL_PORT",
          "value": "587"
        },
        {
          "name": "EMAIL_HOST_USER",
          "value": "rohit.bhatt@protonshub.in"
        },
        {
          "name": "DEFAULT_FROM_EMAIL",
          "value": "rohit.bhatt@protonshub.in"
        },
        {
          "name": "SENTRY_DSN",
          "value": ""
        }
      ],
      "secrets": [
        {
          "name": "SECRET_KEY",
          "valueFrom": "TYBEE_APP_ARN:SECRET_KEY::"
        },
        {
          "name": "EMAIL_HOST_PASSWORD",
          "valueFrom": "TYBEE_APP_ARN:EMAIL_HOST_PASSWORD::"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:168379940497:secret:DB-VtLI21:password::"
        },
        {
          "name": "DB_USER",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:168379940497:secret:DB-VtLI21:username::"
        },
        {
          "name": "DB_HOST",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:168379940497:secret:DB-VtLI21:host::"
        },
        {
          "name": "DB_PORT",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:168379940497:secret:DB-VtLI21:port::"
        },
        {
          "name": "AWS_ACCESS_KEY_ID",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:168379940497:secret:aws_keys-s9iivr:AWS_ACCESS_KEY_ID::"
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:168379940497:secret:aws_keys-s9iivr:AWS_SECRET_ACCESS_KEY::"
        },
        {
          "name": "AWS_STORAGE_BUCKET_NAME",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:168379940497:secret:aws_keys-s9iivr:AWS_S3_BUCKET_NAME::"
        },
        {
          "name": "AWS_REGION",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:168379940497:secret:aws_keys-s9iivr:AWS_REGION::"
        },
        {
          "name": "AWS_S3_REGION_NAME",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:168379940497:secret:aws_keys-s9iivr:AWS_REGION::"
        }
      ]
    }
  ],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::168379940497:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::168379940497:role/ecsTaskExecutionRole"
}