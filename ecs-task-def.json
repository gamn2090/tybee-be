{
  "family": "tybee-backend-task",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "tybee-backend",
      "image": "<IMAGE_URI>",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "SECRET_KEY", "value": "django-insecure-$*ghk$kn*dadqf!d3_3a2bumg%8ny^9zi34pozyi#x@tk9d_04" },
        { "name": "DEBUG", "value": "True" },
        { "name": "ALLOWED_HOSTS", "value": "localhost,127.0.0.1" },
        { "name": "DB_ENGINE", "value": "django.db.backends.postgresql" },
        { "name": "DB_NAME", "value": "booking_db" },
        { "name": "DB_USER", "value": "booking_user" },
        { "name": "DB_PASSWORD", "value": "booking_pass" },
        { "name": "DB_HOST", "value": "db" },
        { "name": "DB_PORT", "value": "5432" },
        { "name": "AWS_ACCESS_KEY_ID", "value": "" },
        { "name": "AWS_SECRET_ACCESS_KEY", "value": "" },
        { "name": "AWS_STORAGE_BUCKET_NAME", "value": "" },
        { "name": "AWS_S3_REGION_NAME", "value": "" },
        { "name": "AWS_S3_CUSTOM_DOMAIN", "value": "" },
        { "name": "EMAIL_HOST", "value": "smtp.example.com" },
        { "name": "EMAIL_PORT", "value": "587" },
        { "name": "EMAIL_HOST_USER", "value": "your@email.com" },
        { "name": "EMAIL_HOST_PASSWORD", "value": "your_email_password" },
        { "name": "DEFAULT_FROM_EMAIL", "value": "your@email.com" },
        { "name": "SENTRY_DSN", "value": "" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/tybee-backend",
          "awslogs-region": "<AWS_REGION>",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "<ECS_EXECUTION_ROLE_ARN>",
  "taskRoleArn": "<ECS_TASK_ROLE_ARN>"
}
